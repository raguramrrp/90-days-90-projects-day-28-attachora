# ATTACHORA Environment Configuration
# Copy this file to .env for custom configuration if needed.

# Application Environment (development, testing, production)
APP_ENV=development

# Storage Root Directory (Default: ./ATTACHORA_LIBRARY)
ATTACHORA_STORAGE_ROOT=./ATTACHORA_LIBRARY

# SQLite Database Path (Default: ./attachora.db)
ATTACHORA_DB_PATH=./attachora.db

# Max attachment size allowed for processing (in megabytes, default 25MB)
ATTACHORA_MAX_FILE_SIZE_MB=25

# Max uncompressed size for archive inspection (in megabytes, default 100MB)
ATTACHORA_MAX_ARCHIVE_SIZE_MB=100

# Max files inside archive to inspect (default 500)
ATTACHORA_MAX_ARCHIVE_ENTRIES=500

# Auto-approval mode enabled by default (False/True)
ATTACHORA_AUTO_MODE=False

# Minimum confidence required for automatic rule filing without manual approval (0.0 to 1.0)
ATTACHORA_AUTO_CONFIDENCE_THRESHOLD=0.90
